# Farmora Care — Environment Configuration Example
NODE_ENV=development

# Server Port and Client URL
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Local MongoDB or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/farmora_care

# JWT Authentication Secret
JWT_SECRET=farmora_care_super_secure_jwt_secret_key_2026_academic_demo
JWT_EXPIRES_IN=7d

# File Storage (Optional Cloudinary fallback; local storage is active by default)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
